# Whitelist ignore strategy: everything is ignored unless explicitly allowed below.
# Rationale: a KiCad project accumulates machine-local junk (backups, autosaves,
# local UI state, editor history). Only design files, project libraries and
# documentation belong in git.

# ---------- ignore everything ----------
*

# ---------- repository meta ----------
!.gitignore
!.gitattributes
!README.md
!LICENSE

# ---------- KiCad project files (root) ----------
!/*.kicad_pro
!/*.kicad_sch
!/*.kicad_pcb
!/*.kicad_dru
!/*.kicad_wks
!/*.kicad_jobset

# ---------- project library tables ----------
!/fp-lib-table
!/sym-lib-table

# ---------- project libraries and 3D models ----------
!/Library/
!/Library/**/
!/Library/**/*.kicad_sym
!/Library/**/*.kicad_mod
!/Library/**/*.step
!/Library/**/*.wrl
!/Library/**/.gitkeep

# ---------- documentation ----------
!/docs/
!/docs/**/
!/docs/**/*.md
!/docs/**/*.txt
!/docs/**/*.csv
!/docs/**/*.pdf
!/docs/**/*.png
!/docs/**/*.svg

# ---------- fabrication output ----------
!/fabrication/
!/fabrication/**/
!/fabrication/**/*.md
!/fabrication/**/*.csv
!/fabrication/**/*.zip
!/fabrication/**/*.gbr
!/fabrication/**/*.drl
!/fabrication/**/*.pdf

# ---------- explicitly excluded, even if a rule above would match ----------
# Unreferenced logo graphic sitting in a footprint library (kept on disk, not in git)
/Library/tps63070.pretty/catboy.kicad_mod
# KiCad editor history (itself a git repository)
.history/
# Plot / export scratch output
output/
# KiCad automatic backups (zips)
*-backups/
SvayamV3_IIK-backups/
# Local UI state — regenerated by the editor on every session
*.kicad_prl
# Editor lock files
*.lck
~*.lck
# Loose archives and local working notes
*.zip
.deepseek-sources/
.DS_Store
Thumbs.db
